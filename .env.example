# Copy to .env for local development. Replace these values before deployment.
FRONTEND_PORT=8081
MAILPIT_UI_PORT=8025
POSTGRES_DB=user_management
POSTGRES_USER=app
POSTGRES_PASSWORD=dev_password_change_me
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
OTP_EXPIRE_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Defaults send messages to the local Mailpit inbox.
# For Gmail, use smtp.gmail.com:587 with STARTTLS and a Google App Password.
# Keep your real Gmail address and App Password in your local .env only.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
EMAIL_FROM=no-reply@example.com
